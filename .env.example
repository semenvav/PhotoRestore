# Локальная разработка: скопируйте в .env (в контейнере значения задаёт Dockerfile/compose)
DATA_DIR=var/data
DB_PATH=var/restore.db
INTAKE_POLL_S=30
DISPLAY_TZ=Asia/Jerusalem
LOG_LEVEL=INFO
# API агента: без токена отвечает 503. Сгенерировать: python -c "import secrets; print(secrets.token_urlsafe(32))"
AGENT_TOKEN=
# Gemini (платный ключ проекта с биллингом). Без ключа отправка в Gemini недоступна.
GEMINI_API_KEY=
# FAKE_GEMINI=1 — вместо Gemini вход с пометкой и цена 0; промпт с FAKE_REFUSE — отказ модели
# FAKE_GEMINI=1
